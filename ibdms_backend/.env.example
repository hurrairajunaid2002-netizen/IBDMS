# ============================================================
#  IBDMS Backend — Environment Configuration Template
#  Copy this file to .env and fill in your values.
# ============================================================

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_STRING_IN_PRODUCTION

# ── Admin Account (seeded at first startup) ───────────────────────────────────
ADMIN_EMAIL=admin@ibdms.org
ADMIN_PASSWORD=Admin@Secure2026

# ── SMTP Email (Gmail example) ────────────────────────────────────────────────
# 1. Enable 2-Factor Authentication on your Gmail account.
# 2. Go to: Google Account → Security → App Passwords → Generate
# 3. Use the 16-char App Password below (NOT your account password).
# 4. Keep SMTP_USER as the real Gmail address you authenticate with.
#    From/Reply-To must match that address for better inbox delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_NAME=IBDMS
SMTP_REPLY_TO=your-email@gmail.com

# ── Google Sign-In (OAuth 2.0) ────────────────────────────────────────────────
# 1. Go to https://console.firebase.google.com
# 2. Create project → Add Android app (package: com.example.ibdms_frontend)
# 3. Project Settings → General → Your apps → google-services.json
#    (copy to ibdms_frontend/android/app/)
# 4. Project Settings → Service Accounts → Generate new private key
#    (save JSON file, set path below)
# 5. Authentication → Sign-in method → Google → Enable
# 6. Copy the Web client ID from the OAuth 2.0 credentials
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# ── Firebase Admin SDK (for FCM push notifications) ───────────────────────────
# Path to the service-account.json downloaded from Firebase console.
# Example (Windows): C:/Users/YourName/firebase-service-account.json
FIREBASE_CRED=C:/path/to/firebase-service-account.json

# ── Public URL & Server Port ──────────────────────────────────────────────────
NGROK_BASE_URL=https://blah-curve-boxer.ngrok-free.dev
PORT=5000
